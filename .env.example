# Copiez ce fichier en .env (ou utilisez .streamlit/secrets.toml) — ne commitez jamais vos clés.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optionnel : modèles et paramètres (valeurs par défaut indiquées)
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.6-flash
# EMBED_MODEL=BAAI/bge-m3
# MAX_PDF_IMAGES=12
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# MIN_DENSE_SCORE=0.25
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=3
# OCR_TIMEOUT_S=120
# LOG_LEVEL=INFO
# OMNIDOC_DB=./omnidoc.db
# TESSERACT_CMD=/usr/bin/tesseract
